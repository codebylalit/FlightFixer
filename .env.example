# GEMINI_API_KEY: Required for server-side Gemini AI Copilot API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_AIRPORT_API_KEY: Optional external Airport API key (e.g. AeroDataBox / RapidAPI / AviationStack)
# FlightFixer includes a comprehensive built-in offline airport database with exact coordinates,
# so airport search works seamlessly even without an external API key.
VITE_AIRPORT_API_KEY=